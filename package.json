{
  "name": "maquest",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @maquest/mcp build && pnpm --filter @maquest/desktop dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "tsx --test apps/desktop/src/main/history.test.ts packages/core/src/frontmatter.test.mjs apps/desktop/src/renderer/src/lib/connections.test.ts",
    "mcp:build": "pnpm --filter @maquest/mcp build",
    "install:desktop": "bash scripts/install-desktop.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "oxlint && oxfmt --check && pnpm typecheck && pnpm test",
    "check:fix": "oxlint --fix; oxfmt && oxlint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "tsx": "^4.23.15"
  },
  "packageManager": "pnpm@12.3.4"
}
