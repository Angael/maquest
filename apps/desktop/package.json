{
  "name": "@maquest/desktop",
  "version": "0.12.1",
  "private": true,
  "description": "A desktop workspace for stories, novels, screenplays, and tabletop RPG campaigns",
  "author": "Angael",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@maquest/core": "workspace:*",
    "chokidar": "^6.0.0",
    "electron-updater": "^6.8.11",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@base-ui/react": "^1.9.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.5",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@vitejs/plugin-react": "^6.1.2",
    "@xyflow/react": "^12.12.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "use-debounce": "^10.1.1",
    "vite": "^8.3.5",
    "yet-another-react-lightbox": "^3.33.0",
    "zustand": "^5.0.16"
  },
  "build": {
    "appId": "com.angael.maquest",
    "productName": "Maquest",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../packages/mcp/dist",
        "to": "mcp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "npmRebuild": false,
    "artifactName": "Maquest-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Office",
      "executableName": "maquest",
      "icon": "resources/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "Angael",
      "repo": "maquest"
    }
  },
  "desktopName": "maquest.desktop",
  "productName": "Maquest"
}
